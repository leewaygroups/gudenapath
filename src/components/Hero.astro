<section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-nordic-navy">
  <!-- Background layers -->
  <div class="absolute inset-0 bg-gradient-to-br from-deep-navy via-nordic-navy to-arctic-blue"></div>
  <div class="absolute inset-0 opacity-15" style="background-image: radial-gradient(circle at 25% 40%, rgba(59,130,196,0.4) 0%, transparent 50%), radial-gradient(circle at 75% 60%, rgba(239,43,45,0.12) 0%, transparent 50%);"></div>
  <div class="absolute inset-0 opacity-[0.04]" style="background-image: url('data:image/svg+xml,%3Csvg width=&quot;40&quot; height=&quot;40&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;%3E%3Ccircle cx=&quot;20&quot; cy=&quot;20&quot; r=&quot;1&quot; fill=&quot;%23ffffff&quot;/%3E%3C/svg%3E'); background-size: 40px 40px;"></div>

  <!-- Content -->
  <div class="relative z-10 container-narrow text-center px-6 py-32">
    <!-- Eyebrow -->
    <div class="inline-flex items-center gap-3 mb-8" data-aos="fade-down" data-aos-delay="200">
      <span class="block w-8 h-px bg-nordic-red"></span>
      <span class="text-xs font-sans font-semibold tracking-[0.3em] uppercase text-white/60">
        Cross-Border Growth Architecture
      </span>
      <span class="block w-8 h-px bg-nordic-red"></span>
    </div>

    <!-- Headline -->
    <h1
      class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-serif text-white leading-[0.95] tracking-tight"
      data-aos="fade-up"
      data-aos-delay="400"
    >
      The Nordic–China<br />
      <span class="bg-gradient-to-r from-white via-fjord-blue to-white bg-clip-text text-transparent">Growth Infrastructure</span>
      <sup class="text-lg sm:text-xl text-white/40 align-super ml-1">™</sup>
    </h1>

    <!-- Subheadline -->
    <p
      class="mt-8 text-lg sm:text-xl md:text-2xl text-white/70 font-light max-w-3xl mx-auto leading-relaxed text-balance"
      data-aos="fade-up"
      data-aos-delay="600"
    >
      We architect, build, and operate cross-border expansion systems between the Nordics and China.
    </p>

    <!-- Positioning -->
    <div
      class="mt-8 max-w-2xl mx-auto"
      data-aos="fade-up"
      data-aos-delay="700"
    >
      <p class="text-sm sm:text-base text-white/45 leading-relaxed">
        Gudenapath is not a consultancy.<br />
        We are the strategic growth engine powering ambitious companies<br class="hidden sm:block" />
        expanding between Northern Europe and China.
      </p>
    </div>

    <!-- CTAs -->
    <div
      class="mt-12 flex flex-col sm:flex-row items-center justify-center gap-4"
      data-aos="fade-up"
      data-aos-delay="900"
    >
      <a
        href="/contact/"
        class="group px-8 py-4 bg-nordic-red text-white font-semibold text-sm tracking-wide rounded-lg transition-all duration-300 hover:bg-nordic-red-dark hover:shadow-lg hover:shadow-nordic-red/20"
      >
        Build My Expansion Architecture
        <span class="inline-block ml-2 transition-transform duration-300 group-hover:translate-x-1">&rarr;</span>
      </a>
      <a
        href="#what-we-do"
        class="px-8 py-4 border border-white/25 text-white/80 font-medium text-sm tracking-wide rounded-lg transition-all duration-300 hover:border-white/50 hover:text-white hover:bg-white/5"
      >
        Explore the Growth Model
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/25 animate-bounce">
    <span class="text-[10px] tracking-[0.2em] uppercase">Scroll</span>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
  </div>
</section>
