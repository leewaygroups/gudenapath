---
const nordicToChina = [
  'Market validation & feasibility studies',
  'ICP localization & audience mapping',
  'Chinese digital ecosystem strategy (WeChat, Xiaohongshu, Douyin)',
  'Regulatory & compliance coordination',
  'Local partner sourcing & due diligence',
  'Go-to-market architecture',
];

const chinaToNordics = [
  'EU compliance & regulatory navigation',
  'Nordic branding & cultural localization',
  'Distribution & channel partnerships',
  'Investor introductions & capital access',
  'Government & trade facilitation',
  'Market positioning across Nordic markets',
];

const gaasServices = [
  'Performance marketing & demand generation',
  'B2B lead generation & pipeline management',
  'Strategic advisory & quarterly reviews',
  'Local representation & relationship management',
  'On-ground business development',
  'Executive advisory hotline',
];
---

<section class="bg-nordic-navy text-white section-padding-lg" id="what-we-do">
  <div class="container-narrow">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16" data-aos="fade-up">
      <span class="accent-line mx-auto mb-6"></span>
      <h2 class="text-4xl sm:text-5xl lg:text-6xl font-serif leading-tight">
        We Build Expansion Infrastructure.
      </h2>
      <p class="mt-6 text-lg text-white/50">
        Gudenapath designs and operates integrated systems for cross-border growth — in both directions.
      </p>
    </div>

    <!-- Bidirectional services -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-12">
      <!-- Nordic → China -->
      <div
        class="relative p-8 sm:p-10 rounded-xl bg-white/[0.06] border border-white/10 hover:border-white/20 transition-all duration-500"
        data-aos="fade-right"
      >
        <div class="flex items-center gap-3 mb-6">
          <span class="text-2xl">🇩🇰🇸🇪🇳🇴🇫🇮🇮🇸</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-nordic-red"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          <span class="text-2xl">🇨🇳</span>
        </div>
        <h3 class="text-xl font-serif text-white leading-snug mb-2">
          Nordic to China
        </h3>
        <p class="text-sm text-white/40 mb-6">Market Entry Architecture</p>
        <ul class="space-y-3">
          {nordicToChina.map((item) => (
            <li class="flex items-start gap-3 text-sm text-white/60">
              <span class="mt-1.5 block w-1.5 h-1.5 rounded-full bg-fjord-blue flex-shrink-0"></span>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <!-- China → Nordics -->
      <div
        class="relative p-8 sm:p-10 rounded-xl bg-white/[0.06] border border-white/10 hover:border-white/20 transition-all duration-500"
        data-aos="fade-left"
      >
        <div class="flex items-center gap-3 mb-6">
          <span class="text-2xl">🇨🇳</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-nordic-red"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          <span class="text-2xl">🇩🇰🇸🇪🇳🇴🇫🇮🇮🇸</span>
        </div>
        <h3 class="text-xl font-serif text-white leading-snug mb-2">
          China to the Nordics
        </h3>
        <p class="text-sm text-white/40 mb-6">Nordic Market Expansion</p>
        <ul class="space-y-3">
          {chinaToNordics.map((item) => (
            <li class="flex items-start gap-3 text-sm text-white/60">
              <span class="mt-1.5 block w-1.5 h-1.5 rounded-full bg-nordic-red/60 flex-shrink-0"></span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Growth-as-a-Service -->
    <div
      class="relative p-8 sm:p-10 rounded-xl bg-white/[0.04] border border-nordic-red/15"
      data-aos="fade-up"
    >
      <div class="flex flex-col lg:flex-row lg:items-start gap-8">
        <div class="lg:max-w-sm flex-shrink-0">
          <span class="inline-block px-3 py-1 text-[10px] font-semibold tracking-[0.2em] uppercase bg-nordic-red/15 text-nordic-red rounded-md mb-4">
            Recurring Partnership
          </span>
          <h3 class="text-2xl sm:text-3xl font-serif text-white leading-snug">
            Nordic–China Growth&#8209;as&#8209;a&#8209;Service
          </h3>
          <p class="mt-3 text-sm text-white/45 leading-relaxed">
            Move beyond project-based engagements. Our monthly retainer model embeds Gudenapath as your permanent cross-border growth engine — with dedicated teams on both sides.
          </p>
        </div>
        <div class="flex-1 grid grid-cols-1 sm:grid-cols-2 gap-3">
          {gaasServices.map((item) => (
            <div class="flex items-start gap-3 text-sm text-white/55">
              <span class="mt-1.5 block w-1.5 h-1.5 rounded-full bg-nordic-red/50 flex-shrink-0"></span>
              {item}
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Bottom statement -->
    <div class="mt-16 text-center" data-aos="fade-up">
      <p class="text-xl text-white/35 font-light">We don't deliver reports.</p>
      <p class="text-2xl sm:text-3xl font-serif text-white mt-2">
        We deliver <span class="text-nordic-red">operational capability.</span>
      </p>
    </div>
  </div>
</section>
