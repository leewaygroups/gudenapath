      <circle r="2" fill="#3B82C4" opacity="0">
        <animate attributeName="opacity" values="0;0;0.7;0.7;0" dur="3.5s" repeatCount="indefinite" begin="5.5s" />
        <animateMotion dur="3.5s" repeatCount="indefinite" begin="5.5s">
          <mpath href="#spoke-cph" />
        </animateMotion>
      </circle>

      <!-- ===== NORDIC HUB MARKER ===== -->
      <g>
        <circle cx="240" cy="122" r="10" fill="#3B82C4" opacity="0.06" />
        <circle cx="240" cy="122" r="5" fill="#3B82C4" opacity="0.9" />
        <circle cx="240" cy="122" r="2.5" fill="#F7F8FA" />
      </g>

      <!-- ===== TRUNK ARC (Nordic hub → Beijing) ===== -->

      <!-- Faint static trail -->
      <use href="#trunk-path" stroke="#002F6C" stroke-width="1.2" stroke-opacity="0.07" />

      <!-- Draw-on (starts after spokes finish) -->
      <use href="#trunk-path" stroke="#3B82C4" stroke-width="2.2" stroke-opacity="0.5"
           stroke-dasharray="1" stroke-dashoffset="1" pathLength="1">
        <animate attributeName="stroke-dashoffset" from="1" to="0" dur="2.8s" fill="freeze" begin="2s" />
      </use>

      <!-- Glow layer -->
      <use href="#trunk-path" stroke="#3B82C4" stroke-width="7" stroke-opacity="0.1" filter="url(#soft-glow)"
           stroke-dasharray="1" stroke-dashoffset="1" pathLength="1">
        <animate attributeName="stroke-dashoffset" from="1" to="0" dur="2.8s" fill="freeze" begin="2s" />
      </use>

      <!-- Trunk forward particle 1 (Nordic → China) -->
      <circle r="3.5" fill="#3B82C4" opacity="0" filter="url(#glow-blue)">
        <animate attributeName="opacity" values="0;0;0.9;0.9;0" dur="5s" repeatCount="indefinite" begin="5s" />
        <animateMotion dur="5s" repeatCount="indefinite" begin="5s">
          <mpath href="#trunk-path" />
        </animateMotion>
      </circle>

      <!-- Trunk forward particle 2 (offset) -->
      <circle r="2.5" fill="#002F6C" opacity="0" filter="url(#glow-blue)">
        <animate attributeName="opacity" values="0;0;0.6;0.6;0" dur="5s" repeatCount="indefinite" begin="7s" />
        <animateMotion dur="5s" repeatCount="indefinite" begin="7s">
          <mpath href="#trunk-path" />
        </animateMotion>
      </circle>

      <!-- Trunk reverse particle (China → Nordic hub) -->
      <circle r="3" fill="#EF2B2D" opacity="0" filter="url(#glow-red)">
        <animate attributeName="opacity" values="0;0;0.8;0.8;0" dur="6s" repeatCount="indefinite" begin="6s" />
        <animateMotion dur="6s" repeatCount="indefinite" begin="6s" keyPoints="1;0" keyTimes="0;1" calcMode="linear">
          <mpath href="#trunk-path" />
        </animateMotion>
      </circle>

      <!-- ========== CITY MARKERS — NORDICS ========== -->

      <!-- Copenhagen (primary Nordic hub) -->
      <g>
        <circle cx="219" cy="143" r="6" fill="none" stroke="#3B82C4" stroke-width="1" opacity="0">
          <animate attributeName="r" values="6;30" dur="3s" repeatCount="indefinite" />
          <animate attributeName="opacity" values="0.55;0" dur="3s" repeatCount="indefinite" />
        </circle>
        <circle cx="219" cy="143" r="6" fill="none" stroke="#3B82C4" stroke-width="0.8" opacity="0">
          <animate attributeName="r" values="6;30" dur="3s" repeatCount="indefinite" begin="1s" />
          <animate attributeName="opacity" values="0.4;0" dur="3s" repeatCount="indefinite" begin="1s" />
        </circle>
        <circle cx="219" cy="143" r="6" fill="none" stroke="#3B82C4" stroke-width="0.6" opacity="0">
          <animate attributeName="r" values="6;30" dur="3s" repeatCount="indefinite" begin="2s" />
          <animate attributeName="opacity" values="0.25;0" dur="3s" repeatCount="indefinite" begin="2s" />
        </circle>
        <circle cx="219" cy="143" r="5.5" fill="#3B82C4" />
        <circle cx="219" cy="143" r="2.5" fill="#F7F8FA" />
        <text x="219" y="165" text-anchor="middle" fill="#002F6C" font-size="11" font-family="Inter, sans-serif" font-weight="600" opacity="0.8">COPENHAGEN</text>
      </g>

      <!-- Oslo -->
      <g>
        <circle cx="209" cy="112" r="4" fill="#3B82C4" opacity="0.85" />
        <circle cx="209" cy="112" r="2" fill="#F7F8FA" />
        <text x="189" y="106" text-anchor="end" fill="#002F6C" font-size="10" font-family="Inter, sans-serif" font-weight="500" opacity="0.65">OSLO</text>
      </g>

      <!-- Stockholm -->
      <g>
        <circle cx="247" cy="116" r="4" fill="#3B82C4" opacity="0.85" />
        <circle cx="247" cy="116" r="2" fill="#F7F8FA" />
        <text x="247" y="106" text-anchor="middle" fill="#002F6C" font-size="10" font-family="Inter, sans-serif" font-weight="500" opacity="0.65">STOCKHOLM</text>
      </g>

      <!-- Helsinki -->
      <g>
        <circle cx="283" cy="109" r="4" fill="#3B82C4" opacity="0.85" />
        <circle cx="283" cy="109" r="2" fill="#F7F8FA" />
        <text x="305" y="113" text-anchor="start" fill="#002F6C" font-size="10" font-family="Inter, sans-serif" font-weight="500" opacity="0.65">HELSINKI</text>
      </g>

      <!-- Reykjavik -->
      <g>
        <circle cx="41" cy="81" r="3.5" fill="#3B82C4" opacity="0.75" />
        <circle cx="41" cy="81" r="1.5" fill="#F7F8FA" />
        <text x="60" y="85" text-anchor="start" fill="#002F6C" font-size="9" font-family="Inter, sans-serif" font-weight="500" opacity="0.55">REYKJAVIK</text>
      </g>

      <!-- ========== CITY MARKERS — CHINA ========== -->

      <!-- Beijing (primary China hub) -->
      <g>
        <circle cx="753" cy="259" r="6" fill="none" stroke="#EF2B2D" stroke-width="1" opacity="0">
          <animate attributeName="r" values="6;32" dur="3.5s" repeatCount="indefinite" />
          <animate attributeName="opacity" values="0.5;0" dur="3.5s" repeatCount="indefinite" />
        </circle>
        <circle cx="753" cy="259" r="6" fill="none" stroke="#EF2B2D" stroke-width="0.8" opacity="0">
          <animate attributeName="r" values="6;32" dur="3.5s" repeatCount="indefinite" begin="1.2s" />
          <animate attributeName="opacity" values="0.35;0" dur="3.5s" repeatCount="indefinite" begin="1.2s" />
        </circle>
        <circle cx="753" cy="259" r="6" fill="none" stroke="#EF2B2D" stroke-width="0.6" opacity="0">
          <animate attributeName="r" values="6;32" dur="3.5s" repeatCount="indefinite" begin="2.4s" />
          <animate attributeName="opacity" values="0.2;0" dur="3.5s" repeatCount="indefinite" begin="2.4s" />
        </circle>
        <circle cx="753" cy="259" r="6" fill="#EF2B2D" />
        <circle cx="753" cy="259" r="3" fill="#F7F8FA" />
        <text x="753" y="283" text-anchor="middle" fill="#002F6C" font-size="11" font-family="Inter, sans-serif" font-weight="600" opacity="0.8">BEIJING</text>
      </g>

      <!-- Shanghai -->
      <g>
        <circle cx="779" cy="323" r="4" fill="#EF2B2D" opacity="0.75" />
        <circle cx="779" cy="323" r="2" fill="#F7F8FA" />
        <text x="779" y="343" text-anchor="middle" fill="#002F6C" font-size="10" font-family="Inter, sans-serif" font-weight="500" opacity="0.65">SHANGHAI</text>
      </g>

      <!-- ========== GUDENAPATH HUB (midpoint of trunk arc) ========== -->
      <g>
        <circle cx="484" cy="60" r="32" fill="#EF2B2D" opacity="0.04" filter="url(#soft-glow)" />
        <circle cx="484" cy="60" r="18" fill="#EF2B2D" opacity="0.06" />

        <circle cx="484" cy="60" r="14" fill="none" stroke="#002F6C" stroke-width="0.6" opacity="0.15" stroke-dasharray="2.5 2.5">
          <animateTransform attributeName="transform" type="rotate" from="0 484 60" to="360 484 60" dur="20s" repeatCount="indefinite" />
        </circle>

        <circle cx="484" cy="60" r="6.5" fill="#EF2B2D" filter="url(#glow-red)" />
        <circle cx="484" cy="60" r="3" fill="#F7F8FA" />

        <text x="484" y="43" text-anchor="middle" fill="#002F6C" font-size="10" font-family="Inter, sans-serif" font-weight="700" letter-spacing="0.15em" opacity="0.8">GUDENAPATH</text>
        <text x="484" y="31" text-anchor="middle" fill="#EF2B2D" font-size="7.5" font-family="Inter, sans-serif" font-weight="600" letter-spacing="0.1em" opacity="0.55">GROWTH HUB</text>
      </g>

      <!-- ========== REGION LABELS ========== -->
      <text x="185" y="200" text-anchor="middle" fill="#3B82C4" font-size="12" font-family="Inter, sans-serif" font-weight="700" letter-spacing="0.25em" opacity="0.3">NORDICS</text>
      <text x="710" y="410" text-anchor="middle" fill="#EF2B2D" font-size="12" font-family="Inter, sans-serif" font-weight="700" letter-spacing="0.25em" opacity="0.25">CHINA</text>

    </svg>
  </div>

  <!-- Bottom content: country tags + operational reach -->
  <div class="container-narrow mt-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start">
      <!-- Country tags -->
      <div data-aos="fade-up" data-aos-delay="300">
        <div class="flex flex-wrap gap-3">
          {countries.map((country) => (
            <span class:list={[
              "inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg border transition-colors duration-300",
              country.accent
                ? "border-nordic-red/25 text-nordic-red bg-nordic-red/5"
                : "border-frost text-charcoal/70 bg-white hover:border-fjord-blue/30 card-shadow"
            ]}>
              <span class="text-base">{country.flag}</span>
              {country.name}
            </span>
          ))}
        </div>
      </div>

      <!-- Operational reach -->
      <div class="p-6 rounded-xl bg-white border border-frost card-shadow" data-aos="fade-up" data-aos-delay="350">
        <h4 class="text-xs font-sans font-semibold tracking-[0.2em] uppercase text-nordic-red mb-4">
          Our Operational Reach
        </h4>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {[
            'Nordic Advisory Council of senior industry leaders',
            'Strategic partners in each Nordic country',
            'Local ambassadors with institutional relationships',
            'Government & trade authority networks',
            'China-based team with Nordic-side coordination',
            'University & research institution connections',
          ].map((item) => (
            <div class="flex items-start gap-2 text-sm text-charcoal/60">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-fjord-blue mt-0.5 flex-shrink-0"><polyline points="20 6 9 17 4 12"></polyline></svg>
              {item}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
