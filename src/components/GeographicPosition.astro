<section class="bg-snow section-padding-lg overflow-hidden" id="geographic">
  <div class="container-narrow">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="accent-line mx-auto mb-6" data-aos="fade-up"></span>
      <h2 class="text-4xl sm:text-5xl font-serif text-nordic-navy leading-tight" data-aos="fade-up" data-aos-delay="100">
        The Unified Nordic Gateway
        <span class="text-fjord-blue">to China.</span>
      </h2>
      <p class="mt-2 text-2xl sm:text-3xl font-serif text-charcoal/40 leading-tight" data-aos="fade-up" data-aos-delay="150">
        The Strategic China Gateway to the Nordics.
      </p>
      <p class="mt-6 text-base text-charcoal/60 leading-relaxed max-w-xl mx-auto" data-aos="fade-up" data-aos-delay="200">
        Instead of fragmented national consultants, we operate as one integrated Nordic platform — a single point of entry for cross-border expansion in either direction.
      </p>
    </div>
  </div>

  <!-- Full-width map visualization -->
  <div class="w-full max-w-6xl mx-auto px-4" data-aos="fade-up" data-aos-delay="250">
    <svg viewBox="0 0 900 480" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto block">
      <defs>
        <filter id="glow-blue" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="5" result="blur" />
