        <!-- Trunk arc: Nordic hub → Beijing -->
        <path id="trunk-path" d="M240 122 C 380 20, 590 15, 753 259" fill="none" />

        <!-- Region glows -->
        <radialGradient id="nordic-glow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#3B82C4" stop-opacity="0.12" />
          <stop offset="100%" stop-color="#3B82C4" stop-opacity="0" />
        </radialGradient>
        <radialGradient id="china-glow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#EF2B2D" stop-opacity="0.1" />
          <stop offset="100%" stop-color="#EF2B2D" stop-opacity="0" />
        </radialGradient>
