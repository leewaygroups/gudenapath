---
const navLinks = [
  { label: 'What We Do', href: '/#what-we-do' },
  { label: 'Offerings', href: '/#offerings' },
  { label: 'Alliance', href: '/#alliance' },
  { label: 'Insights', href: '/insights/' },
];
---

<header id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500">
  <nav class="container-narrow flex items-center justify-between h-20">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <span class="text-2xl font-serif font-bold text-white transition-colors duration-300 group-hover:text-nordic-red">
        Gudenapath
      </span>
    </a>

    <!-- Desktop Nav -->
    <div class="hidden lg:flex items-center gap-8">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm font-medium text-white/80 hover:text-white transition-colors duration-300 tracking-wide"
        >
          {link.label}
        </a>
      ))}
      <a
        href="/contact/"
        class="ml-4 px-6 py-2.5 text-sm font-semibold tracking-wide bg-nordic-red text-white rounded-lg hover:bg-nordic-red-dark transition-all duration-300 shadow-sm hover:shadow-md"
      >
        Strategic Consultation
      </a>
    </div>

    <!-- Mobile Toggle -->
    <button
      id="mobile-toggle"
      class="lg:hidden flex flex-col gap-1.5 p-2"
      aria-label="Toggle navigation"
    >
      <span class="block w-6 h-0.5 bg-white transition-all duration-300 origin-center" id="bar1"></span>
      <span class="block w-6 h-0.5 bg-white transition-all duration-300" id="bar2"></span>
      <span class="block w-4 h-0.5 bg-white transition-all duration-300 origin-center" id="bar3"></span>
    </button>
  </nav>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="lg:hidden fixed inset-0 bg-nordic-navy/98 backdrop-blur-sm z-40 flex flex-col items-center justify-center gap-8 opacity-0 pointer-events-none transition-opacity duration-500">
    <button id="mobile-close" class="absolute top-6 right-6 text-white/60 hover:text-white p-2" aria-label="Close menu">
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="mobile-nav-link text-2xl font-serif text-white/80 hover:text-nordic-red transition-colors duration-300"
      >
        {link.label}
      </a>
    ))}
    <a
      href="/contact/"
      class="mt-4 px-8 py-3 text-sm font-semibold tracking-wide bg-nordic-red text-white rounded-lg hover:bg-nordic-red-dark transition-all duration-300"
    >
      Strategic Consultation
    </a>
  </div>
</header>

<script>
  const navbar = document.getElementById('navbar');
  const toggle = document.getElementById('mobile-toggle');
  const menu = document.getElementById('mobile-menu');
  const closeBtn = document.getElementById('mobile-close');

  let isScrolled = false;

  function updateNavbar() {
    const scrolled = window.scrollY > 60;
    if (scrolled !== isScrolled) {
      isScrolled = scrolled;
      if (scrolled) {
        navbar?.classList.add('bg-nordic-navy/95', 'backdrop-blur-md', 'shadow-lg');
      } else {
        navbar?.classList.remove('bg-nordic-navy/95', 'backdrop-blur-md', 'shadow-lg');
      }
    }
  }

  function openMenu() {
    menu?.classList.remove('opacity-0', 'pointer-events-none');
    menu?.classList.add('opacity-100', 'pointer-events-auto');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    menu?.classList.add('opacity-0', 'pointer-events-none');
    menu?.classList.remove('opacity-100', 'pointer-events-auto');
    document.body.style.overflow = '';
  }

  window.addEventListener('scroll', updateNavbar, { passive: true });
  toggle?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);

  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  updateNavbar();
</script>
