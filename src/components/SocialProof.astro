---
const stats = [
  { value: '5', label: 'Nordic markets connected' },
  { value: '20+', label: 'Years combined team expertise' },
  { value: '2', label: 'Continents, one platform' },
  { value: '1', label: 'End-to-end expansion architecture' },
];

const testimonials = [
  {
    quote: 'Gudenapath didn\'t just help us enter China — they built the operational infrastructure that made sustained growth possible. No other partner understood both sides the way they do.',
    attribution: 'CEO, Nordic Green Tech Company',
    sector: 'Clean Energy',
  },
  {
    quote: 'The depth of their government relationships and institutional access in both regions is unmatched. They opened doors we didn\'t even know existed.',
    attribution: 'Managing Director, Scandinavian MedTech Firm',
    sector: 'Life Science',
  },
  {
    quote: 'We tried three different consultancies before Gudenapath. The difference is they don\'t advise from the outside — they operate from the inside.',
    attribution: 'VP International, Danish Manufacturing Group',
    sector: 'Advanced Manufacturing',
  },
];

const trustedBy = [
  'Nordic green technology scaleups',
  'Scandinavian life science companies',
  'Danish & Swedish manufacturing leaders',
  'Chinese consumer brands entering the Nordics',
  'Government trade promotion agencies',
  'Nordic venture capital & PE firms',
];
---

<section class="bg-nordic-navy text-white section-padding-lg" id="proof">
  <div class="container-narrow">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16" data-aos="fade-up">
      <span class="accent-line mx-auto mb-6"></span>
      <h2 class="text-4xl sm:text-5xl lg:text-6xl font-serif leading-tight">
        Built on Results,<br />Not Promises
      </h2>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      {stats.map((stat, i) => (
        <div
          class="text-center p-6 rounded-xl bg-white/[0.04] border border-white/8"
          data-aos="fade-up"
          data-aos-delay={i * 100}
        >
          <p class="text-3xl sm:text-4xl font-serif text-white leading-none">
            {stat.value}
          </p>
          <p class="mt-2 text-xs text-white/40 tracking-wide uppercase">
            {stat.label}
          </p>
        </div>
      ))}
    </div>

    <!-- Testimonials -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
      {testimonials.map((testimonial, i) => (
        <div
          class="p-8 rounded-xl bg-white/[0.04] border border-white/8 hover:border-white/15 transition-all duration-500"
          data-aos="fade-up"
          data-aos-delay={i * 120}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="text-nordic-red/30 mb-4"><path d="M11.3 2.5c-1.4.7-2.5 1.5-3.3 2.6C7.2 6.2 6.8 7.5 6.8 9c0 .5.1 1 .2 1.3.3-.2.6-.3 1-.3 1.5 0 2.7 1.2 2.7 2.7S9.5 15.4 8 15.4c-1.8 0-3.2-1.5-3.2-3.7 0-2.2.8-4.1 2.3-5.7C8.5 4.5 10 3.6 11.3 3.2V2.5zm8.5 0c-1.4.7-2.5 1.5-3.3 2.6-.8 1.1-1.2 2.4-1.2 3.9 0 .5.1 1 .2 1.3.3-.2.6-.3 1-.3 1.5 0 2.7 1.2 2.7 2.7s-1.2 2.7-2.7 2.7c-1.8 0-3.2-1.5-3.2-3.7 0-2.2.8-4.1 2.3-5.7 1.4-1.5 2.9-2.4 4.2-2.8V2.5z"/></svg>

          <p class="text-sm text-white/60 leading-relaxed mb-6">
            {testimonial.quote}
          </p>

          <div class="border-t border-white/8 pt-4">
            <p class="text-xs text-white/50 font-medium">{testimonial.attribution}</p>
            <p class="text-[10px] text-white/25 uppercase tracking-wide mt-1">{testimonial.sector}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Trusted by categories -->
    <div class="text-center" data-aos="fade-up">
      <p class="text-xs font-semibold tracking-[0.2em] uppercase text-white/30 mb-6">
        Trusted by organizations across
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        {trustedBy.map((item) => (
          <span class="px-4 py-2 text-xs text-white/45 border border-white/8 rounded-lg">
            {item}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
