---
const pillars = [
  {
    title: 'Companies',
    description: 'Nordic and Chinese enterprises pursuing cross-border growth.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V7l8-4v18"/><path d="M19 21V11l-6-4"/></svg>`,
  },
  {
    title: 'Investors',
    description: 'Venture capital, private equity, and sovereign funds active in the corridor.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>`,
  },
  {
    title: 'Government & Trade Bodies',
    description: 'Trade promotion agencies, embassies, and regulatory institutions.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V7l8-4v18"/><path d="M19 21V11l-6-4"/><path d="M9 9h.01"/><path d="M9 12h.01"/><path d="M9 15h.01"/></svg>`,
  },
  {
    title: 'Universities & Research',
    description: 'Academic institutions driving Nordic-Asian innovation and talent.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>`,
  },
];

const activities = [
  'Annual Nordic–China Business Summit',
  'Quarterly CEO roundtables across Nordic capitals',
  'Curated investor-founder matching events',
  'Government policy briefing series',
  'Industry-specific working groups',
  'Cross-border research publications',
];
---

<section class="bg-snow section-padding-lg" id="alliance">
  <div class="container-narrow">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      <!-- Left: intro -->
      <div>
        <span class="accent-line mb-6" data-aos="fade-right"></span>
        <span class="inline-block px-3 py-1 text-[10px] font-semibold tracking-[0.2em] uppercase bg-nordic-red/8 text-nordic-red rounded-md mb-4" data-aos="fade-right" data-aos-delay="50">
          Ecosystem Initiative
        </span>
        <h2 class="text-4xl sm:text-5xl font-serif text-nordic-navy leading-tight" data-aos="fade-right" data-aos-delay="100">
          The Nordic–China<br />
          <span class="text-nordic-red">Business Alliance</span>
        </h2>
        <p class="mt-6 text-base text-charcoal/60 leading-relaxed" data-aos="fade-right" data-aos-delay="200">
          Category kings build ecosystems, not just companies. The Nordic-China Business Alliance is our platform for convening the companies, investors, government leaders, and academic institutions shaping the future of this corridor.
        </p>
        <p class="mt-4 text-base text-charcoal/60 leading-relaxed" data-aos="fade-right" data-aos-delay="250">
          Gudenapath is the orchestrator — connecting capital with ambition, policy with practice, and ideas with execution.
        </p>

        <!-- Activities -->
        <div class="mt-8" data-aos="fade-right" data-aos-delay="300">
          <h4 class="text-xs font-semibold tracking-[0.2em] uppercase text-charcoal/35 mb-4">
            Alliance Activities
          </h4>
          <ul class="space-y-2">
            {activities.map((activity) => (
              <li class="flex items-start gap-2 text-sm text-charcoal/55">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-nordic-red mt-0.5 flex-shrink-0"><polyline points="20 6 9 17 4 12"></polyline></svg>
                {activity}
              </li>
            ))}
          </ul>
        </div>

        <a
          href="/contact/"
          class="inline-flex items-center gap-2 mt-8 text-sm font-semibold tracking-wide text-nordic-red hover:text-nordic-red-dark transition-colors duration-300"
          data-aos="fade-right"
          data-aos-delay="400"
        >
          Inquire About Membership
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
      </div>

      <!-- Right: stakeholder cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        {pillars.map((pillar, i) => (
          <div
            class="group p-6 rounded-xl bg-white border border-frost hover:border-fjord-blue/20 card-shadow hover:card-shadow-hover transition-all duration-500"
            data-aos="fade-left"
            data-aos-delay={100 + i * 100}
          >
            <div class="w-10 h-10 flex items-center justify-center rounded-lg bg-nordic-navy/5 text-nordic-navy group-hover:bg-nordic-red/8 group-hover:text-nordic-red transition-all duration-300 mb-4" set:html={pillar.icon} />
            <h3 class="text-base font-serif text-nordic-navy leading-snug mb-2">
              {pillar.title}
            </h3>
            <p class="text-xs text-charcoal/45 leading-relaxed">
              {pillar.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
