<section class="relative bg-nordic-navy text-white section-padding-lg overflow-hidden">
  <!-- Subtle pattern -->
  <div class="absolute inset-0 opacity-[0.03]" style="background-image: url('data:image/svg+xml,%3Csvg width=&quot;40&quot; height=&quot;40&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;%3E%3Ccircle cx=&quot;20&quot; cy=&quot;20&quot; r=&quot;1&quot; fill=&quot;%23ffffff&quot;/%3E%3C/svg%3E'); background-size: 40px 40px;"></div>

  <div class="relative z-10 container-narrow">
    <div class="max-w-4xl mx-auto text-center">
      <!-- Eyebrow -->
      <div class="inline-flex items-center gap-3 mb-10" data-aos="fade-down">
        <span class="block w-8 h-px bg-nordic-red/50"></span>
        <span class="text-xs font-sans font-semibold tracking-[0.3em] uppercase text-white/50">
          We Believe
        </span>
        <span class="block w-8 h-px bg-nordic-red/50"></span>
      </div>

      <!-- Core statement -->
      <h2 class="text-4xl sm:text-5xl lg:text-6xl font-serif leading-tight" data-aos="fade-up" data-aos-delay="200">
        Expansion is not a transaction.<br />
        <span class="text-fjord-blue">It is an architectural challenge.</span>
      </h2>

      <!-- Values -->
      <div class="mt-16 flex flex-wrap justify-center gap-x-12 gap-y-6" data-aos="fade-up" data-aos-delay="400">
        {['Precision', 'Respect', 'Strategy', 'Patience', 'Structure'].map((value) => (
          <span class="text-lg sm:text-xl font-serif text-white/35 hover:text-nordic-red transition-colors duration-500 cursor-default">
            {value}
          </span>
        ))}
      </div>

      <!-- Closing statement -->
      <div class="mt-16 max-w-2xl mx-auto" data-aos="fade-up" data-aos-delay="600">
        <p class="text-base sm:text-lg text-white/35 leading-relaxed">
          Growth between civilizations demands more than advice.
        </p>
        <p class="mt-4 text-lg sm:text-xl text-white/65 leading-relaxed font-light">
          We don't chase short-term wins.<br />
          We build <span class="text-white font-medium">enduring cross-border platforms.</span>
        </p>
      </div>
    </div>
  </div>
</section>
