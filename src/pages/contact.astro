---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Strategic Consultation — Gudenapath"
  description="Request a strategic consultation to discuss your cross-border expansion between the Nordics and China."
>
  <Navbar />

  <main>
    <!-- Hero -->
    <section class="bg-nordic-navy pt-32 pb-20">
      <div class="container-narrow text-center">
        <span class="accent-line mx-auto mb-6"></span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-serif text-white leading-tight">
          Request Strategic<br />
          <span class="text-fjord-blue">Consultation</span>
        </h1>
        <p class="mt-6 text-lg text-white/50 max-w-2xl mx-auto">
          If you are serious about scaling between the Nordics and China, share your situation below and our team will prepare for a focused conversation.
        </p>
      </div>
    </section>

    <!-- Form -->
    <section class="bg-snow section-padding">
      <div class="container-narrow">
        <div class="max-w-2xl mx-auto bg-white rounded-xl card-shadow p-8 sm:p-12">
          <form
            action="https://formspree.io/f/info@gudenapath.com"
            method="POST"
            class="space-y-8"
          >
            <!-- Name -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="first-name" class="block text-xs font-semibold tracking-[0.15em] uppercase text-charcoal/50 mb-2">
                  First Name
                </label>
                <input
                  type="text"
                  name="first-name"
                  id="first-name"
                  required
                  class="w-full px-4 py-3 bg-snow border border-frost rounded-lg text-charcoal text-sm focus:border-fjord-blue focus:outline-none focus:ring-2 focus:ring-fjord-blue/10 transition-all duration-300"
                />
              </div>
              <div>
                <label for="last-name" class="block text-xs font-semibold tracking-[0.15em] uppercase text-charcoal/50 mb-2">
                  Last Name
                </label>
                <input
                  type="text"
                  name="last-name"
                  id="last-name"
                  required
                  class="w-full px-4 py-3 bg-snow border border-frost rounded-lg text-charcoal text-sm focus:border-fjord-blue focus:outline-none focus:ring-2 focus:ring-fjord-blue/10 transition-all duration-300"
                />
              </div>
            </div>

            <!-- Email & Company -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="email" class="block text-xs font-semibold tracking-[0.15em] uppercase text-charcoal/50 mb-2">
                  Email
                </label>
                <input
                  type="email"
                  name="email"
                  id="email"
                  required
                  class="w-full px-4 py-3 bg-snow border border-frost rounded-lg text-charcoal text-sm focus:border-fjord-blue focus:outline-none focus:ring-2 focus:ring-fjord-blue/10 transition-all duration-300"
                />
              </div>
              <div>
                <label for="company" class="block text-xs font-semibold tracking-[0.15em] uppercase text-charcoal/50 mb-2">
                  Company
                </label>
                <input
                  type="text"
                  name="company"
                  id="company"
                  class="w-full px-4 py-3 bg-snow border border-frost rounded-lg text-charcoal text-sm focus:border-fjord-blue focus:outline-none focus:ring-2 focus:ring-fjord-blue/10 transition-all duration-300"
                />
              </div>
            </div>

            <!-- Direction -->
            <div>
              <label for="direction" class="block text-xs font-semibold tracking-[0.15em] uppercase text-charcoal/50 mb-2">
                Expansion Direction
              </label>
              <select
                name="direction"
                id="direction"
                class="w-full px-4 py-3 bg-snow border border-frost rounded-lg text-charcoal text-sm focus:border-fjord-blue focus:outline-none focus:ring-2 focus:ring-fjord-blue/10 transition-all duration-300 appearance-none"
              >
                <option value="">Select direction</option>
                <option value="nordic-to-china">Nordic to China</option>
                <option value="china-to-nordic">China to the Nordics</option>
                <option value="both">Both directions</option>
              </select>
            </div>

            <!-- Interest -->
            <div>
              <label for="interest" class="block text-xs font-semibold tracking-[0.15em] uppercase text-charcoal/50 mb-2">
                Primary Interest
              </label>
              <select
                name="interest"
                id="interest"
                class="w-full px-4 py-3 bg-snow border border-frost rounded-lg text-charcoal text-sm focus:border-fjord-blue focus:outline-none focus:ring-2 focus:ring-fjord-blue/10 transition-all duration-300 appearance-none"
              >
                <option value="">Select offering</option>
                <option value="expansion-blueprint">Expansion Blueprint</option>
                <option value="growth-infrastructure">Growth Infrastructure Build</option>
                <option value="embedded-partner">Embedded Expansion Partner</option>
                <option value="strategic-access">Nordic-China Strategic Access</option>
                <option value="general">General consultation</option>
              </select>
            </div>

            <!-- Message -->
            <div>
              <label for="message" class="block text-xs font-semibold tracking-[0.15em] uppercase text-charcoal/50 mb-2">
                Tell us about your expansion goals
              </label>
              <textarea
                name="message"
                id="message"
                rows="5"
                class="w-full px-4 py-3 bg-snow border border-frost rounded-lg text-charcoal text-sm focus:border-fjord-blue focus:outline-none focus:ring-2 focus:ring-fjord-blue/10 transition-all duration-300 resize-vertical"
              ></textarea>
            </div>

            <!-- Submit -->
            <div>
              <button
                type="submit"
                class="group w-full sm:w-auto px-10 py-4 bg-nordic-red text-white font-semibold text-sm tracking-wide rounded-lg transition-all duration-300 hover:bg-nordic-red-dark hover:shadow-lg hover:shadow-nordic-red/20"
              >
                Request Consultation
                <span class="inline-block ml-2 transition-transform duration-300 group-hover:translate-x-1">&rarr;</span>
              </button>
            </div>

            <p class="text-xs text-charcoal/30">
              We typically respond within 48 business hours. Your information is kept confidential.
            </p>
          </form>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
