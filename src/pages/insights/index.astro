---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('insights')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout
  title="Nordic-China Growth Index — Gudenapath"
  description="Quarterly intelligence on regulatory shifts, trade flows, industry insights, and risk forecasting for Nordic-China business."
>
  <Navbar />

  <main>
    <!-- Hero -->
    <section class="bg-nordic-navy pt-32 pb-20">
      <div class="container-narrow">
        <span class="accent-line mb-6"></span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-serif text-white leading-tight">
          The Nordic–China<br />
          <span class="text-fjord-blue">Growth Index</span>
        </h1>
        <p class="mt-6 text-lg text-white/50 max-w-2xl">
          Quarterly intelligence covering regulatory shifts, trade flows, industry insights, case studies, and risk forecasting.
        </p>
      </div>
    </section>

    <!-- Articles -->
    <section class="bg-snow section-padding">
      <div class="container-narrow">
        {posts.length === 0 ? (
          <p class="text-center text-charcoal/40 text-lg py-16">
            Inaugural edition coming soon. Stay tuned.
          </p>
        ) : (
          <div class="space-y-6">
            {posts.map((post) => (
              <a
                href={`/insights/${post.id.replace(/\.mdx?$/, '')}/`}
                class="group block p-8 sm:p-10 bg-white rounded-xl border border-frost hover:border-fjord-blue/20 card-shadow hover:card-shadow-hover transition-all duration-500"
              >
                <div class="flex flex-col sm:flex-row sm:items-start gap-4">
                  <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4">
                    <span class="inline-block px-3 py-1 text-[10px] font-semibold tracking-[0.15em] uppercase bg-nordic-navy/5 text-nordic-navy border border-frost w-fit">
                      {post.data.tag}
                    </span>
                    <time class="text-xs text-charcoal/30" datetime={post.data.date.toISOString()}>
                      {post.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
                    </time>
                  </div>
                </div>
                <h2 class="mt-4 text-xl sm:text-2xl font-serif text-nordic-navy leading-snug group-hover:text-fjord-blue transition-colors duration-300">
                  {post.data.title}
                </h2>
                <p class="mt-3 text-sm text-charcoal/50 leading-relaxed max-w-3xl">
                  {post.data.description}
                </p>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
