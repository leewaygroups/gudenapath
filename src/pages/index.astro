import GeographicPosition from '../components/GeographicPosition.astro';
import StrategicFocus from '../components/StrategicFocus.astro';
import FlagshipOfferings from '../components/FlagshipOfferings.astro';
import ExecutivePrograms from '../components/ExecutivePrograms.astro';
import SocialProof from '../components/SocialProof.astro';
import GrowthIndexTeaser from '../components/GrowthIndexTeaser.astro';
import Leadership from '../components/Leadership.astro';
import WhyGudenapath from '../components/WhyGudenapath.astro';
